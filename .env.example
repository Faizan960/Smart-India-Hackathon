OPENWEATHERMAP_API_KEY=
CARTO_BASEMAP_KEY=

# --- Sentinel ML inference backend (FastAPI on Render) ---
# Set on VERCEL (frontend): the Render service origin the browser calls for ML
# inference. Surfaced to the browser via /api/config/public (no Vite build step).
# Dev default is http://localhost:8000 when unset.
VITE_SENTINEL_API_URL=

# Set on RENDER (backend): the deployed frontend origin allowed by CORS
# (e.g. https://<your-app>.vercel.app). Comma-separated list allowed.
FRONTEND_ORIGIN=
